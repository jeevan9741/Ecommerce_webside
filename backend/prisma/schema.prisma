// E-Commerce Training Academy — database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CourseType {
  EBOOK
  VIDEO
  ZOOM
  CENTRE
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  CREDITED
  REVERSED
}

enum ReferralClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnerCardStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum PartnerCardRequestKind {
  FREE
  REISSUE
}

/// PENDING = awaiting admin review. Approval generates the card in the same step, so an
/// approved request is recorded directly as ISSUED.
enum PartnerCardRequestStatus {
  AWAITING_PAYMENT
  PENDING
  REJECTED
  ISSUED
  CANCELLED
}

enum PartnerCardPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum PayoutMethodType {
  BANK
  UPI
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum LiveSessionStatus {
  SCHEDULED
  CANCELLED
}

enum OtpPurpose {
  HOME_ACCESS
  REGISTER
  LOGIN_RESET
}

enum WorkType {
  WORK_FROM_HOME
  OFFICE
  HYBRID
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum JobApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       DateTime?
  phone               String?
  username            String    @unique
  passwordHash        String
  role                Role      @default(USER)
  referralCode        String    @unique
  preferredLanguageId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  preferredLanguage        Language?                          @relation("PreferredLanguage", fields: [preferredLanguageId], references: [id])
  orders                   Order[]                            @relation("CustomerOrders")
  referredOrders           Order[]                            @relation("ReferrerOrders")
  courseAccess             CourseAccess[]
  commissions              CommissionLedger[]
  payoutMethods            PayoutMethod[]
  withdrawalRequests       WithdrawalRequest[]
  referralClaims           ReferralClaim[]
  partnerCard              PartnerCard?
  videoProgress            VideoProgress[]
  auditLogs                AuditLog[]
  courseCertificates       CourseCertificate[]
  franchiseApplications    FranchiseApplication[]
  privacyNoticeAcceptances FranchisePrivacyNoticeAcceptance[]
  franchisePartner         FranchisePartner?
  franchiseStudentLinks    FranchiseStudent[]                 @relation("FranchiseStudentUser")
  franchiseInvitesAccepted FranchiseStudentInvite[]           @relation("InviteAcceptedBy")
  supportTicketsOpened     SupportTicket[]                    @relation("TicketOpenedBy")
  supportTicketsClosed     SupportTicket[]                    @relation("TicketClosedBy")
  supportTicketMessages    SupportTicketMessage[]             @relation("TicketMessageAuthor")
  supportTicketEvents      SupportTicketEvent[]               @relation("TicketEventActor")
  policiesCreated          PolicyVersion[]                    @relation("PolicyCreatedBy")
  policiesApproved         PolicyVersion[]                    @relation("PolicyApprovedBy")
  approvalsRequested       AdminApprovalRequest[]             @relation("ApprovalRequestedBy")
  approvalsDecided         AdminApprovalRequest[]             @relation("ApprovalDecidedBy")
  /// Admin two-factor authentication (TOTP) enrolments; at most one not disabled at a time.
  mfaFactors               AdminMfaFactor[]

  @@index([referralCode])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

model Course {
  id                String     @id @default(cuid())
  slug              String     @unique
  type              CourseType
  title             String
  shortDescription  String
  description       String
  priceInPaise      Int
  commissionInPaise Int
  isActive          Boolean    @default(true)
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  languageVideos CourseLanguageVideo[]
  modules        Module[]
  orders         Order[]
  access         CourseAccess[]
  referralClaims ReferralClaim[]
  videos         CourseVideo[]
  /// Topic categories this package unlocks (see CategoryPackage).
  categories     CategoryPackage[]
  certificates   CourseCertificate[]
  ebooks         EBook[]
  liveSessions   LiveSession[]

  @@index([type])
}

/**
 * Optional curriculum structure for VIDEO courses that want a full lesson breakdown
 * instead of (or in addition to) the single per-language video on CourseLanguageVideo.
 */
model Module {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  videoUrl     String?
  subtitleUrl  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

/// An original course video uploaded by an admin. The file and thumbnail live in the private
/// Blob store; students only ever receive short-lived signed URLs, and only for courses they own.
model CourseVideo {
  id              String   @id @default(cuid())
  /// Videos reach students through a package (courseId) and/or a topic category (categoryId);
  /// with neither they're never shown to students.
  courseId        String?
  /// The category — or subcategory — the video is filed under (see CourseCategory).
  categoryId      String?
  /// Spoken language of the video (optional; lets students filter a multi-language course).
  languageId      String?
  title           String
  description     String?
  storageKey      String   @unique
  thumbnailKey    String?
  mimeType        String   @default("video/mp4")
  sizeBytes       BigInt
  durationSeconds Int?
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  category CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  language Language?       @relation(fields: [languageId], references: [id], onDelete: SetNull)
  progress VideoProgress[]

  @@index([courseId, displayOrder])
  @@index([categoryId, displayOrder])
}

/// Topic library for course videos (Meesho, Flipkart, …). One level of nesting: a category can have
/// subcategories; videos are filed in a subcategory, or directly in a category that has none.
/// Access is granted per top-level category by the packages linked in CategoryPackage, and covers
/// all of its subcategories.
model CourseCategory {
  id             String   @id @default(cuid())
  /// Null for a top-level category; set for a subcategory.
  parentId       String?
  name           String
  slug           String   @unique
  description    String?
  displayOrder   Int      @default(0)
  /// Inactive categories (and everything under them) are hidden from students.
  isActive       Boolean  @default(true)
  /// Listed as a display-only platform label in the homepage demo section (top-level categories only).
  showOnHomepage Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent     CourseCategory?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   CourseCategory[]  @relation("CategoryTree")
  videos     CourseVideo[]
  packages   CategoryPackage[]
  demoVideos DemoVideo[]
  ebooks     EBook[]

  @@index([parentId, displayOrder])
}

/// Buying `courseId` (a package) unlocks top-level category `categoryId` and all its subcategories.
model CategoryPackage {
  categoryId String
  courseId   String
  createdAt  DateTime @default(now())

  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([categoryId, courseId])
  @@index([courseId])
}

/// Where a student is in a video, saved periodically by the player.
model VideoProgress {
  id                 String    @id @default(cuid())
  userId             String
  videoId            String
  positionSeconds    Int       @default(0)
  /// Furthest point reached, so seeking back doesn't lower the progress bar.
  maxPositionSeconds Int       @default(0)
  /// Parts of the video actually played, as merged [start, end] second ranges. Only continuous
  /// playback paced by real time is credited, so skipping ahead doesn't count as watching.
  watchedRanges      Json      @default("[]")
  /// When the player last reported; bounds how much playback the next report may credit.
  lastReportAt       DateTime?
  /// Set once 90% of the video has been watched (see watchedRanges). Rows completed under the
  /// older position-based rule stay completed.
  completed          Boolean   @default(false)
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CourseVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

/// A downloadable e-book for a package (e.g. "E-Books & Company Support"). The file lives in the
/// private Blob store; only buyers of `courseId` (paid, not refunded) get short-lived signed links.
model EBook {
  id           String   @id @default(cuid())
  /// The package whose buyers may download it.
  courseId     String
  /// Optional topic the e-book is grouped under (display only — access always comes from the package).
  categoryId   String?
  /// Language the e-book is written in (display only). Required for new uploads; null on e-books
  /// uploaded before languages existed.
  languageId   String?
  title        String
  description  String?
  /// Original filename, shown to admins and used as the download name.
  fileName     String
  storageKey   String   @unique
  mimeType     String
  sizeBytes    BigInt
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  category CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  language Language?       @relation(fields: [languageId], references: [id], onDelete: SetNull)

  @@index([courseId, displayOrder])
}

/// One live Zoom class of a package (e.g. day 3 of the 7-day training). Times are stored as UTC
/// instants and shown in `timezone`. The join URL is only handed to buyers of `courseId`, and only
/// inside the joining window — it never appears in schedule listings.
model LiveSession {
  id                     String            @id @default(cuid())
  courseId               String
  /// Day of the training (1-7).
  dayNumber              Int
  title                  String
  description            String?
  startsAt               DateTime
  endsAt                 DateTime
  /// IANA timezone the session was scheduled in, e.g. Asia/Kolkata.
  timezone               String            @default("Asia/Kolkata")
  joinUrl                String
  /// How early before the start the Join button unlocks.
  joinOpensMinutesBefore Int               @default(15)
  /// Unpublished sessions are drafts, invisible to students.
  isPublished            Boolean           @default(false)
  status                 LiveSessionStatus @default(SCHEDULED)
  cancelReason           String?
  cancelledAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([courseId, startsAt])
}

model Language {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  nativeName   String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  demoVideos       DemoVideo[]
  courseVideos     CourseLanguageVideo[]
  originalVideos   CourseVideo[]
  ebooks           EBook[]
  preferredByUsers User[]                @relation("PreferredLanguage")

  @@index([isActive])
}

model CourseLanguageVideo {
  id          String   @id @default(cuid())
  courseId    String
  languageId  String
  videoUrl    String?
  subtitleUrl String?
  ebookUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([courseId, languageId])
  @@index([courseId])
  @@index([languageId])
}

/// The free homepage demo video in one language — one per language, the same for every visitor
/// (English is the default and the fallback) — shown without login. Stored in the public Blob
/// store when one is configured (publicUrl set), otherwise in the private store behind signed links.
model DemoVideo {
  id              String   @id @default(cuid())
  languageId      String
  /// Legacy: demos used to be per platform. No longer used; always null for new demos.
  categoryId      String?
  title           String   @default("")
  description     String?
  storageKey      String
  /// Direct CDN URL when the file lives in the public store; null = private store (signed links).
  publicUrl       String?
  thumbnailKey    String?
  thumbnailUrl    String?
  sizeBytes       BigInt?
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  language Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  category CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([languageId, categoryId])
  @@index([categoryId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  courseId          String
  amountInPaise     Int
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?     @unique
  razorpaySignature String?
  selectedLanguage  String?
  referralCodeUsed  String?
  referrerUserId    String?
  createdAt         DateTime    @default(now())
  paidAt            DateTime?

  user                 User                       @relation("CustomerOrders", fields: [userId], references: [id])
  referrer             User?                      @relation("ReferrerOrders", fields: [referrerUserId], references: [id])
  course               Course                     @relation(fields: [courseId], references: [id])
  access               CourseAccess?
  commission           CommissionLedger?
  franchiseAttribution FranchiseOrderAttribution?
  paymentFees          PaymentFeeRecord[]
  refunds              OrderRefund[]
  disputes             PaymentDispute[]

  @@index([userId])
  @@index([referrerUserId])
  @@index([status])
}

model CourseAccess {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  orderId         String    @unique
  languageGranted String?
  unlockedAt      DateTime  @default(now())
  revokedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
}

model CommissionLedger {
  id            String           @id @default(cuid())
  partnerId     String
  orderId       String           @unique
  amountInPaise Int
  status        CommissionStatus @default(PENDING)
  reason        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  partner User  @relation(fields: [partnerId], references: [id])
  order   Order @relation(fields: [orderId], references: [id])

  @@index([partnerId, status])
}

/// A partner's claim for a referred student who paid without their referral link.
/// An admin verifies the UTR and, on approval, sets the commission — which then counts
/// toward the partner's credited balance exactly like a CREDITED ledger entry.
model ReferralClaim {
  id                String              @id @default(cuid())
  partnerId         String
  studentName       String
  studentPhone      String
  courseId          String
  utr               String              @unique
  status            ReferralClaimStatus @default(PENDING)
  commissionInPaise Int?
  adminNote         String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  partner User   @relation(fields: [partnerId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@index([partnerId, status])
  @@index([status])
}

/// A partner's printable ID card. Requested by the partner (PENDING), approved by an admin
/// (ACTIVE), and publicly verifiable at /verify/{partnerId}. `qrToken` is embedded in the QR
/// URL; regenerating or reissuing rotates it so previously printed cards read as superseded.
model PartnerCard {
  id                String            @id @default(cuid())
  userId            String            @unique
  /// Sequence behind the human-readable partnerId (ECTA-BP001, ECTA-BP002, ...).
  number            Int               @unique @default(autoincrement())
  partnerId         String            @unique
  fullName          String
  /// Passport-style photo as a JPEG/PNG data URL (kept small client-side before upload).
  photo             String?
  role              String            @default("Authorized Business Partner")
  location          String
  email             String
  phone             String
  validFrom         DateTime?
  qrToken           String
  qrCodeUrl         String
  /// Authorized-signature image (white ink on transparent PNG data URL); null uses the default mark.
  signature         String?
  status            PartnerCardStatus @default(PENDING)
  adminNote         String?
  /// True once the partner's free card has been issued; further cards go through a paid reissue.
  issued            Boolean           @default(false)
  firstIssuedAt     DateTime?
  /// Number of cards issued so far (first card = 1, each reissue adds one).
  issueCount        Int               @default(0)
  /// Latest issue date.
  issuedAt          DateTime?
  /// Per-partner reissue fee override in paise; null uses the Partner Card Settings fee.
  reissueFeeInPaise Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests PartnerCardRequest[]

  @@index([status])
}

/// One partner request for a card — the free first card or a (usually paid) reissue. Holds the
/// details requested, the fee and its Razorpay payment, and the review outcome: the reissue history.
model PartnerCardRequest {
  id                String                   @id @default(cuid())
  cardId            String
  userId            String
  kind              PartnerCardRequestKind
  status            PartnerCardRequestStatus
  paymentStatus     PartnerCardPaymentStatus @default(NOT_REQUIRED)
  feeInPaise        Int                      @default(0)
  fullName          String
  location          String
  phone             String
  /// New photo for a reissue; null keeps the card's current photo.
  photo             String?
  reason            String?
  razorpayOrderId   String?                  @unique
  razorpayPaymentId String?                  @unique
  paidAt            DateTime?
  adminNote         String?
  reviewedAt        DateTime?
  reviewedById      String?
  /// The card's issue number this request produced, once ISSUED.
  issueNumber       Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  card PartnerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // The migration also adds a partial unique index: one AWAITING_PAYMENT/PENDING request per card.
  @@index([cardId, status])
  @@index([status])
}

model PayoutMethod {
  id               String           @id @default(cuid())
  userId           String
  type             PayoutMethodType
  encryptedDetails String
  label            String
  isDefault        Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user               User                @relation(fields: [userId], references: [id])
  withdrawalRequests WithdrawalRequest[]

  @@index([userId])
}

model WithdrawalRequest {
  id             String           @id @default(cuid())
  partnerId      String
  payoutMethodId String
  amountInPaise  Int
  status         WithdrawalStatus @default(PENDING)
  providerRefId  String?
  failureReason  String?
  requestedAt    DateTime         @default(now())
  processedAt    DateTime?

  partner      User         @relation(fields: [partnerId], references: [id])
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])

  @@index([partnerId, status])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  text         String
  isApproved   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Certificate {
  id           String   @id @default(cuid())
  title        String
  description  String?
  storageKey   String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// A course completion certificate. VIDEO packages issue automatically once every lesson of one
/// language track is completed; other package types (Zoom, offline centre, e-book) are issued by
/// an admin. Name, course title and completion date are frozen at issue, so the certificate never
/// changes afterwards. (Not to be confused with Certificate: the academy's own showcase images.)
model CourseCertificate {
  id            String    @id @default(cuid())
  /// Public certificate ID, e.g. ECA-2026-K7Q3XM.
  certificateNo String    @unique
  userId        String
  courseId      String
  studentName   String
  courseTitle   String
  completedAt   DateTime
  issuedAt      DateTime  @default(now())
  /// Lessons counted at issue (0 for admin-issued certificates).
  lessonCount   Int       @default(0)
  /// Admin who issued it; null when issued automatically on completion.
  issuedById    String?
  revokedAt     DateTime?
  revokedReason String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

/// Kinds of company document shown in the customer dashboard. OTHER covers any further verified
/// business/legal document; the title then says what it is.
enum LegalDocumentType {
  COMPANY_REGISTRATION
  GST_REGISTRATION
  COMPANY_PAN
  MSME_UDYAM
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  OTHER
}

/// A company legal document (PDF) uploaded by an admin. Stored privately and served to customers
/// only while published, through short-lived signed links. Unpublished by default: the owner
/// decides when each file is shown.
model LegalDocument {
  id           String            @id @default(cuid())
  title        String
  type         LegalDocumentType
  description  String?
  /// Original filename, shown to admins and used as the download name.
  fileName     String
  storageKey   String            @unique
  sizeBytes    BigInt
  isPublished  Boolean           @default(false)
  publishedAt  DateTime?
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([isPublished, displayOrder])
}

model JobPosting {
  id           String   @id @default(cuid())
  title        String
  description  String
  eligibility  String
  salary       String
  workType     WorkType
  workingHours String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id               String               @id @default(cuid())
  jobId            String
  applicantName    String
  email            String
  phone            String
  resumeStorageKey String?
  coverNote        String?
  status           JobApplicationStatus @default(NEW)
  createdAt        DateTime             @default(now())

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Employee {
  id            String         @id @default(cuid())
  employeeCode  String         @unique
  name          String
  position      String
  joiningDate   DateTime
  salaryInPaise Int
  workType      WorkType
  status        EmployeeStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}

// ======================================================================================
// ETA National Franchise System — foundation (Phase 2R: schema only, nothing reads it yet)
// ======================================================================================
// All money is integer paise (Int for single payments, BigInt for ledger and settlement sums).
// The migration adds what Prisma can't model, and the app must never work around it:
//   * partial unique indexes (one open application per user, one PRIMARY allocation per district,
//     one PUBLISHED policy per domain, one PAID fee payment per application, …)
//   * CHECK constraints (amount signs, balanced totals, approver ≠ requester, hash formats)
//   * triggers: append-only tables, immutable published policies, and a deferred check that every
//     ledger journal balances (Σ debits = Σ credits, at least two entries) at commit.
// Business values that are still PENDING (GST treatment, NDR formula, reserve release, settlement
// time, referral overlap, TDS, recovery rules, provider, suspension payouts, invoice configuration,
// e-sign provider, reservation/reassignment, renewal, attribution scope) are NOT defaulted here:
// they live in PolicyVersion payloads that Super Admins publish later (two-admin approval).

// ---------- Enums ----------

/// The eight business statuses, in order; REJECTED is handled separately.
enum FranchiseApplicationStatus {
  APPLICATION_SUBMITTED
  UNDER_REVIEW
  INTERVIEW_DISCUSSION
  APPROVED
  PAYMENT_PENDING
  AGREEMENT_PENDING
  ACTIVE_FRANCHISE
  REJECTED
  /// The applicant withdrew it. Never closes or holds a state.
  WITHDRAWN
}

enum FranchiseDocumentKind {
  ID_PROOF
  PHOTO
  ADDRESS_PROOF
  BUSINESS_PLAN
  ADDITIONAL
}

