// E-Commerce Training Academy — database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CourseType {
  EBOOK
  VIDEO
  ZOOM
  CENTRE
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  CREDITED
  REVERSED
}

enum ReferralClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PartnerCardStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum PartnerCardRequestKind {
  FREE
  REISSUE
}

/// PENDING = awaiting admin review. Approval generates the card in the same step, so an
/// approved request is recorded directly as ISSUED.
enum PartnerCardRequestStatus {
  AWAITING_PAYMENT
  PENDING
  REJECTED
  ISSUED
  CANCELLED
}

enum PartnerCardPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum PayoutMethodType {
  BANK
  UPI
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum OtpPurpose {
  HOME_ACCESS
  REGISTER
  LOGIN_RESET
}

enum WorkType {
  WORK_FROM_HOME
  OFFICE
  HYBRID
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum JobApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
  HIRED
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       DateTime?
  phone               String?
  username            String    @unique
  passwordHash        String
  role                Role      @default(USER)
  referralCode        String    @unique
  preferredLanguageId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  preferredLanguage  Language?           @relation("PreferredLanguage", fields: [preferredLanguageId], references: [id])
  orders             Order[]             @relation("CustomerOrders")
  referredOrders     Order[]             @relation("ReferrerOrders")
  courseAccess       CourseAccess[]
  commissions        CommissionLedger[]
  payoutMethods      PayoutMethod[]
  withdrawalRequests WithdrawalRequest[]
  referralClaims     ReferralClaim[]
  partnerCard        PartnerCard?
  videoProgress      VideoProgress[]
  auditLogs          AuditLog[]

  @@index([referralCode])
}

model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
}

model Course {
  id                String     @id @default(cuid())
  slug              String     @unique
  type              CourseType
  title             String
  shortDescription  String
  description       String
  priceInPaise      Int
  commissionInPaise Int
  isActive          Boolean    @default(true)
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  languageVideos CourseLanguageVideo[]
  modules        Module[]
  orders         Order[]
  access         CourseAccess[]
  referralClaims ReferralClaim[]
  videos         CourseVideo[]

  @@index([type])
}

/**
 * Optional curriculum structure for VIDEO courses that want a full lesson breakdown
 * instead of (or in addition to) the single per-language video on CourseLanguageVideo.
 */
model Module {
  id           String   @id @default(cuid())
  courseId     String
  title        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String   @id @default(cuid())
  moduleId     String
  title        String
  videoUrl     String?
  subtitleUrl  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

/// An original course video uploaded by an admin. The file and thumbnail live in the private
/// Blob store; students only ever receive short-lived signed URLs, and only for courses they own.
model CourseVideo {
  id              String   @id @default(cuid())
  /// Unassigned videos (null) are never shown to students.
  courseId        String?
  title           String
  description     String?
  storageKey      String   @unique
  thumbnailKey    String?
  mimeType        String   @default("video/mp4")
  sizeBytes       BigInt
  durationSeconds Int?
  displayOrder    Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  progress VideoProgress[]

  @@index([courseId, displayOrder])
}

/// Where a student is in a video, saved periodically by the player.
model VideoProgress {
  id                 String    @id @default(cuid())
  userId             String
  videoId            String
  positionSeconds    Int       @default(0)
  /// Furthest point reached, so seeking back doesn't lower the progress bar.
  maxPositionSeconds Int       @default(0)
  completed          Boolean   @default(false)
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  video CourseVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model Language {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  nativeName   String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  demoVideo        DemoVideo?
  courseVideos     CourseLanguageVideo[]
  preferredByUsers User[]                @relation("PreferredLanguage")

  @@index([isActive])
}

model CourseLanguageVideo {
  id          String   @id @default(cuid())
  courseId    String
  languageId  String
  videoUrl    String?
  subtitleUrl String?
  ebookUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([courseId, languageId])
  @@index([courseId])
  @@index([languageId])
}

model DemoVideo {
  id         String   @id @default(cuid())
  languageId String   @unique
  storageKey String
  createdAt  DateTime @default(now())

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  courseId          String
  amountInPaise     Int
  status            OrderStatus @default(CREATED)
  razorpayOrderId   String      @unique
  razorpayPaymentId String?     @unique
  razorpaySignature String?
  selectedLanguage  String?
  referralCodeUsed  String?
  referrerUserId    String?
  createdAt         DateTime    @default(now())
  paidAt            DateTime?

  user       User              @relation("CustomerOrders", fields: [userId], references: [id])
  referrer   User?             @relation("ReferrerOrders", fields: [referrerUserId], references: [id])
  course     Course            @relation(fields: [courseId], references: [id])
  access     CourseAccess?
  commission CommissionLedger?

  @@index([userId])
  @@index([referrerUserId])
  @@index([status])
}

model CourseAccess {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  orderId         String    @unique
  languageGranted String?
  unlockedAt      DateTime  @default(now())
  revokedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId])
}

model CommissionLedger {
  id            String           @id @default(cuid())
  partnerId     String
  orderId       String           @unique
  amountInPaise Int
  status        CommissionStatus @default(PENDING)
  reason        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  partner User  @relation(fields: [partnerId], references: [id])
  order   Order @relation(fields: [orderId], references: [id])

  @@index([partnerId, status])
}

/// A partner's claim for a referred student who paid without their referral link.
/// An admin verifies the UTR and, on approval, sets the commission — which then counts
/// toward the partner's credited balance exactly like a CREDITED ledger entry.
model ReferralClaim {
  id                String              @id @default(cuid())
  partnerId         String
  studentName       String
  studentPhone      String
  courseId          String
  utr               String              @unique
  status            ReferralClaimStatus @default(PENDING)
  commissionInPaise Int?
  adminNote         String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  partner User   @relation(fields: [partnerId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@index([partnerId, status])
  @@index([status])
}

/// A partner's printable ID card. Requested by the partner (PENDING), approved by an admin
/// (ACTIVE), and publicly verifiable at /verify/{partnerId}. `qrToken` is embedded in the QR
/// URL; regenerating or reissuing rotates it so previously printed cards read as superseded.
model PartnerCard {
  id                String            @id @default(cuid())
  userId            String            @unique
  /// Sequence behind the human-readable partnerId (ECTA-BP001, ECTA-BP002, ...).
  number            Int               @unique @default(autoincrement())
  partnerId         String            @unique
  fullName          String
  /// Passport-style photo as a JPEG/PNG data URL (kept small client-side before upload).
  photo             String?
  role              String            @default("Authorized Business Partner")
  location          String
  email             String
  phone             String
  validFrom         DateTime?
  qrToken           String
  qrCodeUrl         String
  /// Authorized-signature image (white ink on transparent PNG data URL); null uses the default mark.
  signature         String?
  status            PartnerCardStatus @default(PENDING)
  adminNote         String?
  /// True once the partner's free card has been issued; further cards go through a paid reissue.
  issued            Boolean           @default(false)
  firstIssuedAt     DateTime?
  /// Number of cards issued so far (first card = 1, each reissue adds one).
  issueCount        Int               @default(0)
  /// Latest issue date.
  issuedAt          DateTime?
  /// Per-partner reissue fee override in paise; null uses the Partner Card Settings fee.
  reissueFeeInPaise Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests PartnerCardRequest[]

  @@index([status])
}

/// One partner request for a card — the free first card or a (usually paid) reissue. Holds the
/// details requested, the fee and its Razorpay payment, and the review outcome: the reissue history.
model PartnerCardRequest {
  id                String                   @id @default(cuid())
  cardId            String
  userId            String
  kind              PartnerCardRequestKind
  status            PartnerCardRequestStatus
  paymentStatus     PartnerCardPaymentStatus @default(NOT_REQUIRED)
  feeInPaise        Int                      @default(0)
  fullName          String
  location          String
  phone             String
  /// New photo for a reissue; null keeps the card's current photo.
  photo             String?
  reason            String?
  razorpayOrderId   String?                  @unique
  razorpayPaymentId String?                  @unique
  paidAt            DateTime?
  adminNote         String?
  reviewedAt        DateTime?
  reviewedById      String?
  /// The card's issue number this request produced, once ISSUED.
  issueNumber       Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  card PartnerCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // The migration also adds a partial unique index: one AWAITING_PAYMENT/PENDING request per card.
  @@index([cardId, status])
  @@index([status])
}

model PayoutMethod {
  id               String           @id @default(cuid())
  userId           String
  type             PayoutMethodType
  encryptedDetails String
  label            String
  isDefault        Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user               User                @relation(fields: [userId], references: [id])
  withdrawalRequests WithdrawalRequest[]

  @@index([userId])
}

model WithdrawalRequest {
  id             String           @id @default(cuid())
  partnerId      String
  payoutMethodId String
  amountInPaise  Int
  status         WithdrawalStatus @default(PENDING)
  providerRefId  String?
  failureReason  String?
  requestedAt    DateTime         @default(now())
  processedAt    DateTime?

  partner      User         @relation(fields: [partnerId], references: [id])
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])

  @@index([partnerId, status])
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  rating       Int
  text         String
  isApproved   Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model Certificate {
  id           String   @id @default(cuid())
  title        String
  description  String?
  storageKey   String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model JobPosting {
  id           String   @id @default(cuid())
  title        String
  description  String
  eligibility  String
  salary       String
  workType     WorkType
  workingHours String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id               String               @id @default(cuid())
  jobId            String
  applicantName    String
  email            String
  phone            String
  resumeStorageKey String?
  coverNote        String?
  status           JobApplicationStatus @default(NEW)
  createdAt        DateTime             @default(now())

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Employee {
  id            String         @id @default(cuid())
  employeeCode  String         @unique
  name          String
  position      String
  joiningDate   DateTime
  salaryInPaise Int
  workType      WorkType
  status        EmployeeStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}
