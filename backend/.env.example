# Copy to .env for local development. Never commit real values.
# In production, set these in the Render dashboard (Environment tab).

# Exactly "production" only on the live server. Production also requires DATABASE_URL to be the production
# Neon database; anything else is non-production and refuses LIVE Razorpay keys and production Blob stores.
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Neon/Render/etc.)
DATABASE_URL=

# Session tokens. Long random strings: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Signs the short-lived "email verified" token between OTP and registration (falls back to JWT_SECRET)
EMAIL_VERIFICATION_SECRET=
# Encrypts payout details at rest — exactly 64 hex chars: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Public frontend URL used in email links (receipts). Defaults to the live site in production.
# SITE_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call the API (no trailing slash)
# Production: https://ecommercetrainingacademyeta.com,https://www.ecommercetrainingacademyeta.com
CORS_ORIGINS=http://localhost:3000

# Email: "console" (dev only — prints OTPs to the server log), "resend" (production) or "smtp"
EMAIL_PROVIDER=console
# Must be on a domain verified in Resend (Resend → Domains), e.g.
# E-Commerce Training Academy <no-reply@ecommercetrainingacademyeta.com> — never @resend.dev in production
EMAIL_FROM=
RESEND_API_KEY=
# Optional: absolute URL of the logo shown in emails (defaults to the live site's /brand/eta-logo-email.png)
# EMAIL_LOGO_URL=
# Only for EMAIL_PROVIDER=smtp (port 465 uses TLS, 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
# Local/staging: rzp_test_ keys only — the server refuses to start (and to build a Razorpay client) with
# rzp_live_ or unrecognised keys outside production. Production refuses rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<backend>/api/webhooks/razorpay — events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# Optional automated payouts (RazorpayX) — leave false until KYC is complete
RAZORPAYX_ENABLED=false
RAZORPAYX_ACCOUNT_NUMBER=

# Vercel Blob token for course content / demo video / certificate uploads (private store)
# Outside production use a development store: a production store's token (or an unrecognisable token)
# stops the server at startup and every storage call is refused.
BLOB_READ_WRITE_TOKEN=
# Optional: separate public Blob store for demo videos (same rule)
BLOB_PUBLIC_READ_WRITE_TOKEN=
# Not used by this app. If set (Vercel OIDC auth with VERCEL_OIDC_TOKEN), a production or malformed store
# id is refused outside production, like a token.
# BLOB_STORE_ID=

# Optional: extra Neon endpoint id(s) of the production DB, comma-separated. Add the new endpoint BEFORE
# moving the production database, or production refuses to start. Only adds; can't remove built-in ones.
# PRODUCTION_DATABASE_ENDPOINTS=
# Optional: extra production Blob store id(s), comma-separated, with or without "store_". Only adds.
# PRODUCTION_BLOB_STORE_IDS=

# Franchise dark launch: the public and applicant franchise API (/api/franchise/*) answers 404 unless this
# is exactly "true". Admin franchise pages work either way. Leave unset in production until approved.
# FRANCHISE_PUBLIC_ENABLED=false
# Franchise partner dashboard API (/api/franchise-partner/*): 404 unless exactly "true". Independent of
# the public switch. Leave unset in production until approved.
# FRANCHISE_PARTNER_ENABLED=false

# Only read by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=
