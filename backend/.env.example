# Copy to .env for local development. Never commit real values.
# In production, set these in the Render dashboard (Environment tab).

NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Neon/Render/etc.)
DATABASE_URL=

# Session tokens. Long random strings: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Signs the short-lived "email verified" token between OTP and registration (falls back to JWT_SECRET)
EMAIL_VERIFICATION_SECRET=
# Encrypts payout details at rest — exactly 64 hex chars: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Comma-separated frontend origins allowed to call the API (no trailing slash)
# Production: https://ecommerce-training-academy-jeevan-f45f.vercel.app
CORS_ORIGINS=http://localhost:3000

# Email: "console" (dev only — prints OTPs to the server log), "resend" (production) or "smtp"
EMAIL_PROVIDER=console
# Must be on a domain verified in Resend, e.g. E-Commerce Training Academy <no-reply@yourdomain.com>
EMAIL_FROM=
RESEND_API_KEY=
# Only for EMAIL_PROVIDER=smtp (port 465 uses TLS, 587 STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<backend>/api/webhooks/razorpay — events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# Optional automated payouts (RazorpayX) — leave false until KYC is complete
RAZORPAYX_ENABLED=false
RAZORPAYX_ACCOUNT_NUMBER=

# Vercel Blob token for course content / demo video / certificate uploads
BLOB_READ_WRITE_TOKEN=

# Only read by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_PASSWORD=
