# Copy to .env for local development. In production, set these in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at build time — redeploy after changing them.

# Express backend (no trailing slash). REQUIRED in production — the build fails without it.
# Production: https://ecommerce-webside.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000
# This site's public URL. Production: https://www.ecommercetrainingacademyeta.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Franchise dark launch: the public franchise pages and their navigation links exist only when this is
# exactly "true" (baked in at build time). Leave unset in production until approved.
# NEXT_PUBLIC_FRANCHISE_PUBLIC_ENABLED=false
# Franchise partner dashboard (/franchise-partner) and its navigation link: only when exactly "true".
# NEXT_PUBLIC_FRANCHISE_PARTNER_ENABLED=false
# Optional: origin printed in partner-card QR codes (defaults to NEXT_PUBLIC_SITE_URL)
# NEXT_PUBLIC_VERIFY_ORIGIN=
